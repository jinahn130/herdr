#!/bin/sh
set -eu

herdr_bin="${HERDR_BIN_PATH:-herdr}"
active_pane="${HERDR_ACTIVE_PANE_ID:-}"
active_workspace="${HERDR_ACTIVE_WORKSPACE_ID:-}"
active_cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
placement="${1:-tab}"

if [ -z "$active_pane" ]; then
  printf '%s\n' "No focused Herdr agent was found." >&2
  exit 1
fi

agent_json=$("$herdr_bin" agent get "$active_pane")
agent_kind=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent // empty')
session_id=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent_session.value // empty')

if [ "$agent_kind" != "codex" ] || [ -z "$session_id" ]; then
  printf '%s\n' "The focused pane is not a resumable Codex session." >&2
  exit 1
fi

case "$placement" in
  tab)
    if [ -z "$active_workspace" ]; then
      printf '%s\n' "No active Herdr workspace was found." >&2
      exit 1
    fi
    created_json=$("$herdr_bin" tab create \
      --workspace "$active_workspace" \
      --cwd "$active_cwd" \
      --label "fork" \
      --focus)
    new_pane=$(printf '%s' "$created_json" | jq -r '.result.root_pane.pane_id // empty')
    ;;
  right|down)
    created_json=$("$herdr_bin" pane split "$active_pane" --direction "$placement" --focus)
    new_pane=$(printf '%s' "$created_json" | jq -r '.result.pane.pane_id // empty')
    ;;
  *)
    printf '%s\n' "Usage: herdr-fork-codex [tab|right|down]" >&2
    exit 2
    ;;
esac

if [ -z "$new_pane" ]; then
  printf '%s\n' "Herdr could not create the destination pane." >&2
  exit 1
fi

agent_name="fork-$(date +%H%M%S)-$$"
# A newly split login shell needs a moment before Herdr can safely replace it.
sleep 1
exec "$herdr_bin" agent start "$agent_name" \
  --kind codex \
  --pane "$new_pane" \
  --timeout 60000 \
  -- \
  --no-alt-screen \
  --dangerously-bypass-approvals-and-sandbox \
  fork "$session_id"
