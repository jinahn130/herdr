#!/bin/sh
set -eu

herdr_bin="${HERDR_BIN_PATH:-herdr}"
active_pane="${HERDR_ACTIVE_PANE_ID:-}"
active_workspace="${HERDR_ACTIVE_WORKSPACE_ID:-}"
active_cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

pause_and_fail() {
  printf '\n%s\n' "$1" >&2
  printf '%s' "Press Enter to close..." >&2
  IFS= read -r _ignored || true
  exit 1
}

if [ -z "$active_pane" ] || [ -z "$active_workspace" ]; then
  pause_and_fail "Focus a Codex agent inside a Herdr Git workspace first."
fi

agent_json=$("$herdr_bin" agent get "$active_pane" 2>/dev/null) || \
  pause_and_fail "The focused pane is not a running agent."
agent_kind=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent // empty')
session_id=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent_session.value // empty')

if [ "$agent_kind" != "codex" ] || [ -z "$session_id" ]; then
  pause_and_fail "The focused pane is not a resumable Codex session."
fi

repo_root=$(git -C "$active_cwd" rev-parse --show-toplevel 2>/dev/null) || \
  pause_and_fail "The focused workspace is not inside a Git repository."

if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
  pause_and_fail "This repository has uncommitted changes. Commit them first so the new worktree receives the same code."
fi

default_branch="codex/context-fork-$(date +%m%d-%H%M%S)"
printf 'New branch [%s]: ' "$default_branch"
IFS= read -r branch_name || branch_name=""
branch_name="${branch_name:-$default_branch}"

git -C "$repo_root" check-ref-format --branch "$branch_name" >/dev/null 2>&1 || \
  pause_and_fail "Invalid Git branch name: $branch_name"

label=$(printf '%s' "$branch_name" | awk -F/ '{print $NF}')
printf '\nCreating worktree %s...\n' "$branch_name"
worktree_json=$("$herdr_bin" worktree create \
  --workspace "$active_workspace" \
  --branch "$branch_name" \
  --label "$label" \
  --focus) || pause_and_fail "Herdr could not create the worktree."

new_pane=$(printf '%s' "$worktree_json" | jq -r '.result.root_pane.pane_id // empty')
if [ -z "$new_pane" ]; then
  pause_and_fail "The worktree was created, but Herdr returned no root pane."
fi

agent_name=$(printf 'ctx-%s-%s' "$label" "$$" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-' | cut -c1-32)
printf 'Forking focused Codex context into %s...\n' "$label"

# Let the new worktree's login shell finish initialization before replacing it.
sleep 1
exec "$herdr_bin" agent start "$agent_name" \
  --kind codex \
  --pane "$new_pane" \
  --timeout 60000 \
  -- \
  --no-alt-screen \
  --dangerously-bypass-approvals-and-sandbox \
  fork "$session_id"
