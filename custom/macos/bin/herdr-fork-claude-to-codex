#!/bin/sh
set -eu

herdr_bin="${HERDR_BIN_PATH:-herdr}"
active_pane="${HERDR_ACTIVE_PANE_ID:-}"
helper_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -z "$active_pane" ]; then
  printf '%s\n' "No focused Herdr pane was found." >&2
  exit 1
fi

agent_json=$("$herdr_bin" agent get "$active_pane")
agent_kind=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent // empty')
agent_status=$(printf '%s' "$agent_json" | jq -r '.result.agent.agent_status // empty')
active_cwd=$(printf '%s' "$agent_json" | jq -r '.result.agent.cwd // empty')

if [ "$agent_kind" != "claude" ]; then
  printf '%s\n' "This transfer requires a focused Claude context." >&2
  exit 1
fi

if [ "$agent_status" = "working" ]; then
  printf '%s\n' "Wait for the current Claude turn to finish, then try again." >&2
  exit 1
fi

session_json=$(
  HERDR_BIN_PATH="$herdr_bin" "$helper_root/herdr-resolve-agent-session" "$active_pane"
)
session_id=$(printf '%s' "$session_json" | jq -r '.value // empty')

case "$session_id" in
  ????????-????-????-????-????????????) ;;
  *)
    printf '%s\n' "The focused Claude pane has no exact transferable session ID yet." >&2
    exit 1
    ;;
esac

if [ ! -d "$HOME/.claude/projects" ] || ! command -v rg >/dev/null 2>&1; then
  printf '%s\n' "Claude session storage is unavailable." >&2
  exit 1
fi

transcript_path=$(
  rg --files "$HOME/.claude/projects" 2>/dev/null |
    rg "/${session_id}\\.jsonl$" |
    head -n 1
)

if [ -z "$transcript_path" ] || [ ! -f "$transcript_path" ]; then
  printf '%s\n' "The Claude transcript for this context could not be found." >&2
  exit 1
fi

handoff_dir="$HOME/.cache/herdr/handoffs"
mkdir -p "$handoff_dir"
handoff_file="$handoff_dir/claude-${session_id}-$(date +%Y%m%d-%H%M%S).md"
handoff_tmp=$(mktemp "$handoff_dir/.claude-to-codex.XXXXXX")
trap 'rm -f "$handoff_tmp"' EXIT HUP INT TERM

{
  printf '%s\n\n' "# Claude to Codex context handoff"
  printf '%s\n' "Source Claude session: ${session_id}"
  printf '%s\n\n' "Working directory: ${active_cwd}"
  printf '%s\n\n' "The filesystem and Git state in the working directory are authoritative."
  printf '%s\n\n' "Below are the 24 most recent user/Claude text messages. Tool output, hidden reasoning, attachments, credentials, and provider-specific session metadata are intentionally excluded."

  jq -sr '
    [ .[]
      | select(.isSidechain != true)
      | select(.type == "user" or .type == "assistant")
      | (.message.role // .type) as $role
      | (
          if (.message.content | type) == "string" then
            .message.content
          elif (.message.content | type) == "array" then
            [.message.content[]? | select(.type == "text") | .text // empty]
            | join("\n")
          else
            ""
          end
        ) as $raw_text
      | ($raw_text
          | gsub("(?s)<system-reminder>.*?</system-reminder>"; "")
          | gsub("(?s)<local-command-caveat>.*?</local-command-caveat>"; "")
        ) as $text
      | select(($text | length) > 0)
      | {
          role: $role,
          text: ($text | if length > 6000 then .[-6000:] else . end)
        }
    ]
    | .[-24:]
    | .[]
    | if .role == "user" then
        "## User\n\n" + .text + "\n"
      else
        "## Claude\n\n" + .text + "\n"
      end
  ' "$transcript_path"
} >"$handoff_tmp"

mv "$handoff_tmp" "$handoff_file"
trap - EXIT HUP INT TERM

split_json=$("$herdr_bin" pane split "$active_pane" \
  --direction right \
  --cwd "$active_cwd" \
  --focus)
new_pane=$(printf '%s' "$split_json" | jq -r '.result.pane.pane_id // empty')

if [ -z "$new_pane" ]; then
  printf '%s\n' "Herdr could not create the Codex pane." >&2
  exit 1
fi

new_name="codex-handoff-$(date +%H%M%S)"
sleep 1

"$herdr_bin" agent start "$new_name" \
  --kind codex \
  --pane "$new_pane" \
  --timeout 60000 \
  -- \
  --no-alt-screen \
  --dangerously-bypass-approvals-and-sandbox >/dev/null

handoff_prompt="Continue the work from the Claude session that I semantically forked into this Codex session. Read the local handoff file at ${handoff_file}. Use its recent conversation as context, but treat the current filesystem and Git state in ${active_cwd} as authoritative. Inspect the relevant repository state, identify the latest unresolved user request, and continue that work. Do not merely summarize the handoff unless the work is already complete."

"$herdr_bin" agent prompt "$new_pane" "$handoff_prompt" >/dev/null
