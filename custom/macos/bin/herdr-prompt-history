#!/usr/bin/env python3
"""Return the focused agent's sent prompts in the shape used by Option-L."""

from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
from datetime import datetime


HOME = pathlib.Path.home()


def herdr_json(*args: str) -> dict:
    output = subprocess.check_output([os.environ.get("HERDR_BIN_PATH", "herdr"), *args], text=True)
    return json.loads(output)


def text_from_content(content: object) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    image_number = 0
    for item in content:
        if isinstance(item, str):
            parts.append(item)
        elif isinstance(item, dict):
            kind = item.get("type")
            value = item.get("text") or item.get("content")
            if isinstance(value, str):
                parts.append(value)
            elif kind in {"input_image", "image", "image_url"}:
                image_number += 1
                parts.append(f"[Image #{image_number}]")
    return "\n".join(part for part in parts if part).strip()


def is_injected_context(text: str) -> bool:
    return text.lstrip().startswith(("<environment_context>", "<skills_instructions>", "<permissions instructions>"))


def timestamp_text(value: object, milliseconds: bool = False) -> str:
    try:
        epoch = float(value) / (1000 if milliseconds else 1)
        return datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")
    except (TypeError, ValueError, OSError):
        return ""


def codex_prompts(session_id: str) -> list[dict[str, str]]:
    # This is Codex's prompt-history store—the same data Ctrl-R searches.
    path = HOME / ".codex" / "history.jsonl"
    if not path.is_file():
        return []
    prompts: list[dict[str, str]] = []
    with path.open(encoding="utf-8") as handle:
        for raw in handle:
            try:
                entry = json.loads(raw)
                if entry.get("session_id") != session_id:
                    continue
                text = entry.get("text", "")
                if isinstance(text, str) and text:
                    prompts.append({"timestamp": timestamp_text(entry.get("ts")), "text": text})
            except json.JSONDecodeError:
                continue
    return prompts


def claude_prompts(session_id: str) -> list[dict[str, str]]:
    # Claude Code also keeps a dedicated typed-prompt history for its picker.
    path = HOME / ".claude" / "history.jsonl"
    if not path.is_file():
        return []
    prompts: list[dict[str, str]] = []
    with path.open(encoding="utf-8") as handle:
        for raw in handle:
            try:
                entry = json.loads(raw)
                if entry.get("sessionId") != session_id:
                    continue
                text = entry.get("display", "")
                if isinstance(text, str) and text:
                    prompts.append({"timestamp": timestamp_text(entry.get("timestamp"), milliseconds=True), "text": text})
            except json.JSONDecodeError:
                continue
    return prompts


def main() -> int:
    pane_list = herdr_json("pane", "list").get("result", {}).get("panes", [])
    focused = next((pane for pane in pane_list if pane.get("focused")), None)
    if not focused:
        print(json.dumps({"error": "Focus a Herdr agent pane first.", "prompts": []}))
        return 0
    session = focused.get("agent_session", {})
    session_id = session.get("value", "")
    agent = focused.get("agent", "")
    prompts = codex_prompts(session_id) if agent == "codex" else claude_prompts(session_id) if agent == "claude" else []
    print(json.dumps({"agent": agent, "name": focused.get("name") or focused.get("pane_id"), "prompts": prompts}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
