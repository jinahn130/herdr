#!/bin/sh
set -eu

herdr_bin="${HERDR_BIN_PATH:-herdr}"
active_pane="${HERDR_ACTIVE_PANE_ID:-}"
axis="${1:-}"
change="${2:-}"

if [ -z "$active_pane" ]; then
  exit 1
fi

case "$axis:$change" in
  width:grow)
    first=right; first_opposite=left; second=left; second_opposite=right
    ;;
  width:shrink)
    first=right; first_opposite=left; second=left; second_opposite=right
    ;;
  height:grow)
    first=down; first_opposite=up; second=up; second_opposite=down
    ;;
  height:shrink)
    first=down; first_opposite=up; second=up; second_opposite=down
    ;;
  *)
    exit 2
    ;;
esac

neighbor_in() {
  "$herdr_bin" pane neighbor --pane "$active_pane" --direction "$1" 2>/dev/null |
    jq -r '.result.neighbor.neighbor_pane_id // empty'
}

first_neighbor=$(neighbor_in "$first")
if [ -n "$first_neighbor" ]; then
  chosen_direction="$first"
  chosen_opposite="$first_opposite"
  chosen_neighbor="$first_neighbor"
else
  second_neighbor=$(neighbor_in "$second")
  if [ -z "$second_neighbor" ]; then
    exit 0
  fi
  chosen_direction="$second"
  chosen_opposite="$second_opposite"
  chosen_neighbor="$second_neighbor"
fi

if [ "$change" = "grow" ]; then
  target_pane="$active_pane"
  resize_direction="$chosen_direction"
else
  # Grow the adjacent pane toward the focused pane, which shrinks the focused pane.
  target_pane="$chosen_neighbor"
  resize_direction="$chosen_opposite"
fi

exec "$herdr_bin" pane resize \
  --pane "$target_pane" \
  --direction "$resize_direction" \
  --amount 0.05
