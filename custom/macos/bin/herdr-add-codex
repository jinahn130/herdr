#!/bin/sh
set -eu

herdr_bin="${HERDR_BIN_PATH:-herdr}"
active_pane="${HERDR_ACTIVE_PANE_ID:-}"

if [ -z "$active_pane" ]; then
  printf '%s\n' "No focused Herdr pane was found." >&2
  exit 1
fi

target_pane="$active_pane"
if "$herdr_bin" agent get "$active_pane" >/dev/null 2>&1; then
  split_json=$("$herdr_bin" pane split "$active_pane" --direction right --focus)
  target_pane=$(printf '%s' "$split_json" | jq -r '.result.pane.pane_id // empty')
  if [ -z "$target_pane" ]; then
    printf '%s\n' "Herdr created no new pane." >&2
    exit 1
  fi
fi

agent_name="agent-$(date +%H%M%S)-$$"
# A newly split login shell needs a moment before Herdr can safely replace it.
sleep 1
exec "$herdr_bin" agent start "$agent_name" \
  --kind codex \
  --pane "$target_pane" \
  --timeout 60000 \
  -- \
  --no-alt-screen \
  --dangerously-bypass-approvals-and-sandbox
