#!/usr/bin/env python3
import curses
import json
import os
import subprocess
import sys
import textwrap
import time


def wrapped_lines(text: str, width: int) -> list[str]:
    width = max(8, width)
    output: list[str] = []
    for source_line in text.splitlines() or [""]:
        if not source_line:
            output.append("")
            continue
        output.extend(
            textwrap.wrap(
                source_line,
                width=width,
                replace_whitespace=False,
                drop_whitespace=False,
                break_long_words=True,
                break_on_hyphens=False,
            )
            or [""]
        )
    return output


def consume_escape_tail(window) -> None:
    """Consume Alt-key/CSI bytes before the popup exits."""
    window.nodelay(True)
    deadline = time.monotonic() + 0.12
    while time.monotonic() < deadline:
        try:
            window.get_wch()
        except curses.error:
            time.sleep(0.005)
    curses.flushinp()


def copy_to_clipboard(text: str) -> bool:
    """Copy without relying on terminal-selection support in the popup."""
    try:
        subprocess.run(["pbcopy"], input=text.encode("utf-8"), check=True)
        return True
    except (OSError, subprocess.CalledProcessError):
        return False


def view(window, text: str) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    # Do not enable mouse reporting here. That lets Herdr own drag selections
    # in the popup, including the normal Cmd-C copy path.
    window.keypad(True)
    offset = 0
    notice = ""

    while True:
        height, width = window.getmaxyx()
        body_height = max(1, height - 2)
        lines = wrapped_lines(text, width - 2)
        max_offset = max(0, len(lines) - body_height)
        offset = min(offset, max_offset)

        window.erase()
        header_text = os.environ.get(
            "HERDR_PROMPT_VIEWER_TITLE",
            "LAST SENT PROMPT · C copies all · Option-L or Esc closes",
        )
        header = f" {header_text} "
        try:
            window.addnstr(0, 0, header.ljust(width), width, curses.A_REVERSE | curses.A_BOLD)
        except curses.error:
            pass

        for row, line in enumerate(lines[offset : offset + body_height], start=1):
            try:
                window.addnstr(row, 1, line, max(1, width - 2))
            except curses.error:
                pass

        if len(lines) > body_height and width > 12:
            status = f" {offset + 1}-{min(len(lines), offset + body_height)}/{len(lines)} "
            try:
                window.addnstr(height - 1, max(0, width - len(status)), status, len(status), curses.A_DIM)
            except curses.error:
                pass
        if notice:
            try:
                window.addnstr(height - 1, 1, notice, max(1, width - 2), curses.A_DIM)
            except curses.error:
                pass

        window.refresh()
        window.timeout(-1)
        key = window.get_wch()

        if key == "\x1b":
            consume_escape_tail(window)
            return
        if key in ("q", "Q"):
            curses.flushinp()
            return
        if key in ("c", "C", "\x03"):
            notice = "Copied full prompt" if copy_to_clipboard(text) else "Could not copy prompt"
            continue
        if key in (curses.KEY_UP, "k"):
            offset = max(0, offset - 1)
        elif key in (curses.KEY_DOWN, "j"):
            offset = min(max_offset, offset + 1)
        elif key == curses.KEY_PPAGE:
            offset = max(0, offset - body_height)
        elif key == curses.KEY_NPAGE:
            offset = min(max_offset, offset + body_height)
        elif key == curses.KEY_HOME:
            offset = 0
        elif key == curses.KEY_END:
            offset = max_offset
        elif key == curses.KEY_MOUSE:
            try:
                _, _, _, _, button_state = curses.getmouse()
                if button_state & curses.BUTTON4_PRESSED:
                    offset = max(0, offset - 3)
                elif hasattr(curses, "BUTTON5_PRESSED") and button_state & curses.BUTTON5_PRESSED:
                    offset = min(max_offset, offset + 3)
            except curses.error:
                pass


def prompt_history_view(window, payload: dict) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    window.keypad(True)
    prompts = payload.get("prompts", [])
    selected = max(0, len(prompts) - 1)
    list_offset = 0
    detail_offset = 0
    notice = ""

    while True:
        height, width = window.getmaxyx()
        list_height = max(4, height // 2 - 1)
        detail_top = list_height + 2
        detail_height = max(1, height - detail_top - 1)
        if prompts:
            selected = min(selected, len(prompts) - 1)
            if selected < list_offset:
                list_offset = selected
            if selected >= list_offset + list_height:
                list_offset = selected - list_height + 1

        window.erase()
        title = os.environ.get("HERDR_PROMPT_VIEWER_TITLE", "PROMPT HISTORY · C copies selected · Esc closes")
        try:
            window.addnstr(0, 0, f" {title} ".ljust(width), width, curses.A_REVERSE | curses.A_BOLD)
        except curses.error:
            pass

        if not prompts:
            message = payload.get("error") or "No sent prompts were found for this agent session."
            try:
                window.addnstr(2, 2, message, max(1, width - 4))
            except curses.error:
                pass
        else:
            for row, index in enumerate(range(list_offset, min(len(prompts), list_offset + list_height)), start=1):
                prompt = prompts[index]
                preview = " ".join(prompt.get("text", "").split())
                timestamp = prompt.get("timestamp", "").replace("T", " ").replace("Z", "")[-14:]
                line = f" {timestamp:>14}  {preview}"
                attr = curses.A_REVERSE if index == selected else curses.A_NORMAL
                try:
                    window.addnstr(row, 1, line, max(1, width - 2), attr)
                except curses.error:
                    pass

            try:
                window.hline(list_height + 1, 1, curses.ACS_HLINE, max(1, width - 2))
            except curses.error:
                pass
            selected_text = prompts[selected].get("text", "")
            detail_lines = wrapped_lines(selected_text, width - 4)
            max_detail_offset = max(0, len(detail_lines) - detail_height)
            detail_offset = min(detail_offset, max_detail_offset)
            for row, line in enumerate(
                detail_lines[detail_offset : detail_offset + detail_height],
                start=detail_top,
            ):
                try:
                    window.addnstr(row, 2, line, max(1, width - 4), curses.A_DIM)
                except curses.error:
                    pass
            if len(detail_lines) > detail_height:
                notice = (
                    f"Full prompt {detail_offset + 1}-"
                    f"{min(len(detail_lines), detail_offset + detail_height)}/{len(detail_lines)}"
                    " · PgUp/PgDn scroll · C copies all"
                )

        if notice:
            try:
                window.addnstr(height - 1, 2, notice, max(1, width - 4), curses.A_DIM)
            except curses.error:
                pass
        window.refresh()
        key = window.get_wch()
        if key == "\x1b":
            consume_escape_tail(window)
            return
        if key in ("q", "Q"):
            return
        if key in ("c", "C", "\x03") and prompts:
            copied = copy_to_clipboard(prompts[selected].get("text", ""))
            notice = "Copied complete selected prompt" if copied else "Could not copy prompt"
        elif key in (curses.KEY_UP, "k") and prompts:
            selected = max(0, selected - 1)
            detail_offset = 0
            notice = ""
        elif key in (curses.KEY_DOWN, "j") and prompts:
            selected = min(len(prompts) - 1, selected + 1)
            detail_offset = 0
            notice = ""
        elif key == curses.KEY_PPAGE and prompts:
            detail_offset = max(0, detail_offset - detail_height)
        elif key == curses.KEY_NPAGE and prompts:
            detail_offset = min(max_detail_offset, detail_offset + detail_height)
        elif key == curses.KEY_HOME and prompts:
            detail_offset = 0
        elif key == curses.KEY_END and prompts:
            detail_offset = max_detail_offset


def main() -> int:
    if len(sys.argv) != 2:
        return 2
    with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as handle:
        prompt = handle.read()
    if os.environ.get("HERDR_PROMPT_VIEWER_MODE") == "history":
        try:
            payload = json.loads(prompt)
        except json.JSONDecodeError:
            payload = {"error": "Could not load prompt history.", "prompts": []}
        curses.wrapper(prompt_history_view, payload)
    else:
        curses.wrapper(view, prompt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
